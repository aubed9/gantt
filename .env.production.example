# ==============================================================================
# rpm_V1 Platform Production Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.production: cp .env.production.example .env.production
# 2. Populate AVALAI_API_KEY with your production key from https://web.avalai.ir
# 3. Adjust passwords and ports for your target environment.
# 4. Run: docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# ==============================================================================

# 1. Database & pgvector (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Dev host port is 5534 to avoid conflicts with native PostgreSQL on 5432/5532.
POSTGRES_USER=rpm_user
POSTGRES_PASSWORD=rpm_secret_password_change_in_prod
POSTGRES_DB=rpm_v1
POSTGRES_PORT=5534
POSTGRES_HOST=postgres
DATABASE_URL=postgresql://rpm_user:rpm_secret_password_change_in_prod@postgres:5432/rpm_v1

# 2. AvalAI API (OpenAI-compatible endpoints for DeepSeek & Gemini STT)
# ------------------------------------------------------------------------------
# Base URL: https://api.avalai.ir/v1
# Key required for production LLM reasoning and multimodal STT transcription.
AVALAI_API_KEY=your_production_avalai_key_here
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_CHAT_MODEL=deepseek-v4.1-flash
AVALAI_STT_MODEL=gemini-3.8-flash
AVALAI_EMBEDDING_MODEL=text-embedding-3-small

# 3. Application Gateway & Mastra Studio Ports
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3120
HOST=0.0.0.0
MASTRA_STUDIO_PORT=4111
HTTP_PORT=80

# 4. Boot & Lifecycle Options
# ------------------------------------------------------------------------------
# Set to true on first initialization if database requires initial fixture seeding
SEED_ON_BOOT=false
