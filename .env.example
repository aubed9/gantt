# rpm_V1 Platform Environment Configuration
# ==========================================

# 1. Database & pgvector (PostgreSQL 16 on Host Port 5534)
POSTGRES_USER=rpm_user
POSTGRES_PASSWORD=rpm_secret_password
POSTGRES_DB=rpm_v1
POSTGRES_PORT=5534
DATABASE_URL=postgresql://rpm_user:rpm_secret_password@localhost:5534/rpm_v1

# 2. AvalAI API (OpenAI-compatible endpoints for DeepSeek & Gemini STT)
# Base URL: https://api.avalai.ir/v1
# Obtain key from: https://web.avalai.ir
AVALAI_API_KEY=your_avalai_api_key_here
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_CHAT_MODEL=deepseek-v4.1-flash
AVALAI_STT_MODEL=gemini-3.8-flash
AVALAI_EMBEDDING_MODEL=text-embedding-3-small

# 3. Mastra Telemetry & Studio
MASTRA_STUDIO_PORT=4111
MASTRA_APP_PORT=3120
NODE_ENV=development
