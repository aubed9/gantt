{
	"name": "dhtmlx-gantt",
	"version": "10.0.3",
	"description": "DHTMLX Gantt - open source JavaScript Gantt chart (Community edition)",
	"type": "module",
	"main": "codebase/dhtmlxgantt.js",
	"module": "codebase/dhtmlxgantt.es.js",
	"types": "codebase/dhtmlxgantt.d.ts",
	"style": "codebase/dhtmlxgantt.css",
	"files": [
		"codebase",
		"whatsnew.md",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "vite build && node scripts/postbuild.js",
		"watch": "vite build --watch",
		"start": "concurrently \"npm:watch\" \"node scripts/server.js\" \"vite\"",
		"server": "node scripts/server.js",
		"test": "node scripts/test.js",
		"lint": "eslint src",
		"verify:infra": "node scripts/verify-infrastructure.js",
		"db:migrate": "tsx packages/database/src/migrator.ts",
		"db:seed": "tsx packages/database/src/seeds/seed.ts",
		"verify:db": "tsx scripts/verify-database.ts",
		"server:rpm": "tsx chatbot/server/src/server.ts",
		"test:mastra": "vitest run test/mastra",
		"test:gateway": "vitest run test/gateway",
		"test:unit": "vitest run",
		"studio": "tsx chatbot/server/src/studio/server.ts",
		"test:studio": "vitest run test/studio",
		"verify:compose": "tsx scripts/verify-docker-compose.ts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/DHTMLX/gantt.git"
	},
	"author": "XB Software",
	"license": "MIT",
	"homepage": "https://dhtmlx.com/docs/products/dhtmlxGantt/",
	"keywords": [
		"gantt",
		"gantt-chart",
		"project-management",
		"javascript",
		"typescript",
		"scheduler",
		"timeline",
		"dhtmlx"
	],
	"devDependencies": {
		"@ai-sdk/openai": "^4.0.110",
		"@mastra/core": "^1.82.0",
		"@reticlehq/browser": "^3.6.0",
		"@reticlehq/vite-plugin": "^3.6.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"ai": "^7.0.164",
		"chalk": "^5.3.0",
		"chokidar": "^4.0.1",
		"concurrently": "^8.2.2",
		"cors": "^2.8.6",
		"dotenv": "^18.0.9",
		"eslint": "^9.12.0",
		"express": "^4.21.0",
		"glob": "^13.0.0",
		"kysely": "^0.29.8",
		"less": "^4.2.0",
		"pg": "^8.23.1",
		"puppeteer": "^24.15.0",
		"sirv": "^2.0.4",
		"striptags": "^3.2.0",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.8.0",
		"vite": "^7.3.5",
		"vitest": "^5.1.0",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"jalaali-js": "^2.0.1"
	}
}
